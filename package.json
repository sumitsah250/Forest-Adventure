{
  "name": "hollow-creek",
  "private": true,
  "version": "0.1.0",
  "description": "A realistic forest mystery and exploration game built with three.js and Rapier.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sim": "node tests/sim.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "test:campus": "node scripts/campus-test.mjs play",
    "campus:data": "node scripts/build-campus-data.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
